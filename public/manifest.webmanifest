{
  "id": "/",
  "name": "Cliptext — YouTube transcripts",
  "short_name": "Cliptext",
  "description": "Turn YouTube videos into clean, copy-ready transcripts.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#191b1c",
  "theme_color": "#191b1c",
  "icons": [
    { "src": "/icons/cliptext-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/cliptext-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/cliptext-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
